{
  "name": "@agentspec/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "agentspec": "./dist/bin/agentspec.js",
    "agentlint": "./dist/bin/agentspec.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
