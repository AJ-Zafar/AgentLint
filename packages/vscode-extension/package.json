{
  "name": "agentspec-vscode",
  "displayName": "AgentSpec",
  "description": "VS Code extension for AgentSpec YAML diagnostics and commands.",
  "version": "0.1.0",
  "publisher": "agentspec",
  "type": "module",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:agentspec",
    "onCommand:agentspec.validateCurrentFile",
    "onCommand:agentspec.lintCurrentFile"
  ],
  "contributes": {
    "languages": [
      {
        "id": "agentspec",
        "aliases": [
          "AgentSpec"
        ],
        "extensions": [
          ".agentspec.yaml",
          ".agentspec.yml"
        ],
        "filenamePatterns": [
          "*.agentspec.yaml",
          "*.agentspec.yml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "agentspec.validateCurrentFile",
        "title": "AgentSpec: Validate Current File"
      },
      {
        "command": "agentspec.lintCurrentFile",
        "title": "AgentSpec: Lint Current File"
      }
    ]
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentspec/parser": "workspace:*",
    "@agentspec/linter": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "latest"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJ-Zafar/AgentLint.git",
    "directory": "packages/vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/AJ-Zafar/AgentLint/issues"
  },
  "homepage": "https://github.com/AJ-Zafar/AgentLint#readme"
}
