{
  "name": "agentspec-vscode",
  "displayName": "Agent Lint",
  "description": "VS Code language server support for Agent Lint YAML files.",
  "version": "0.1.0",
  "publisher": "agentspec",
  "type": "module",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:agentspec",
    "onCommand:agentspec.validateCurrentFile",
    "onCommand:agentspec.lintCurrentFile",
    "onCommand:agentspec.previewGraph",
    "onCommand:agentspec.runTests",
    "onCommand:agentspec.compareDiff"
  ],
  "contributes": {
    "languages": [
      {
        "id": "agentspec",
        "aliases": [
          "AgentSpec"
        ],
        "extensions": [
          ".agentspec.yaml",
          ".agentspec.yml"
        ],
        "filenamePatterns": [
          "*.agentspec.yaml",
          "*.agentspec.yml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "agentspec.validateCurrentFile",
        "title": "AgentSpec: Validate Current File"
      },
      {
        "command": "agentspec.lintCurrentFile",
        "title": "AgentSpec: Lint Current File"
      },
      {
        "command": "agentspec.previewGraph",
        "title": "AgentSpec: Preview Behaviour Graph"
      },
      {
        "command": "agentspec.runTests",
        "title": "AgentSpec: Run Tests"
      },
      {
        "command": "agentspec.compareDiff",
        "title": "AgentSpec: Compare Current File"
      }
    ]
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentspec/diff": "workspace:*",
    "@agentspec/grammar": "workspace:*",
    "@agentspec/linter": "workspace:*",
    "@agentspec/parser": "workspace:*",
    "@agentspec/test-runner": "workspace:*",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/vscode": "latest"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJ-Zafar/AgentLint.git",
    "directory": "packages/vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/AJ-Zafar/AgentLint/issues"
  },
  "homepage": "https://github.com/AJ-Zafar/AgentLint#readme"
}
